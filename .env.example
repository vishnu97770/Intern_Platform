# ==============================================================================
# Intern Platform — Environment Configuration Template
# Copy this file to .env and fill in real values. NEVER commit the real .env.
# ==============================================================================

# ---- Local dev database container (docker-compose) -------------------------
POSTGRES_USER=intern_platform
POSTGRES_PASSWORD=change_me_locally
POSTGRES_DB=intern_platform
POSTGRES_PORT=5433
REDIS_PORT=6380

# ---- Backend API (apps/api) -------------------------------------------------
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL connection string used by Prisma. Must match the credentials above
# (or your own managed Postgres instance in staging/production).
DATABASE_URL=postgresql://intern_platform:change_me_locally@localhost:5433/intern_platform?schema=public

# Redis connection string, used by background job queues (Phase 6+).
REDIS_URL=redis://localhost:6380

# How often the auto-apply background scan runs for every student with
# auto-apply enabled, in milliseconds (Phase 6). Defaults to 15 minutes.
AUTO_APPLY_SCAN_INTERVAL_MS=900000

# Secrets used to sign JWT access/refresh tokens. Generate strong random
# values, e.g. `openssl rand -base64 48`. Required for authentication to work.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call the API from a browser.
CORS_ORIGIN=http://localhost:5173

# Directory (relative to apps/api) where uploaded resumes are stored on disk
# for local/dev use. In production this should be swapped for object storage
# (e.g. S3-compatible bucket) behind the same StorageProvider interface.
UPLOAD_DIR=uploads

# ---- Frontend (apps/web) ----------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api

# ---- Future integrations (added when the corresponding phase is built) -----
# Object storage for resumes in production (Phase 2+), e.g. S3-compatible.
# STORAGE_BUCKET=
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=

# AI-assisted resume/job-description parsing (optional). Server-side only —
# never exposed to the frontend, never used in tests (see lib/llm/llmClient.ts).
# With none of these configured, parsing runs on the deterministic parser
# only, exactly as before. Configuring one or more enables an LLM-backed
# ResumeParser/JobDescriptionParser that's tried first and falls back to
# the deterministic parser on any failure. Each provider needs both its
# API key and its model id set to be considered configured. Tried in this
# order: Groq, then Together AI, then OpenRouter.
#
# Groq (https://console.groq.com) — OpenAI-compatible chat completions.
# GROQ_API_KEY=
# GROQ_MODEL=
#
# Together AI (https://api.together.ai) — OpenAI-compatible chat completions.
# TOGETHER_API_KEY=
# TOGETHER_MODEL=
#
# OpenRouter (https://openrouter.ai) — OpenAI-compatible chat completions,
# routes to many underlying models.
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
#
# Per-provider request timeout and total cross-provider budget for one
# parse call, in seconds.
# LLM_TIMEOUT_SECONDS=8
# LLM_TOTAL_BUDGET_SECONDS=20

# Transactional email for notifications (Phase 6+).
# EMAIL_API_KEY=
# EMAIL_FROM=

# Internship source providers (Phase 3+), one per supported integration.
# None of the three currently configured external credentials are an
# internship/job-board or ATS API (they're the LLM providers above) — the
# mock/seed InternshipProvider and demo ApplicationProvider remain active
# until a real internship-discovery or application-submission API is
# available. See PROJECT_PLAN.md.
# INTERNSHIP_PROVIDER_A_API_KEY=
