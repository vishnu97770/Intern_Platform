// Intern Platform schema.
//
// Phase 1: Authentication + Student Profile.
// Phase 2: Resume.
// Phase 3: Internship discovery (InternshipProvider, Internship, InternshipSkill).
//
// Future phases add: MatchResult, AutoApplyRule, Application,
// ApplicationAttempt, Notification. See PROJECT_PLAN.md for the full target
// ERD — those tables are introduced in the phase that actually uses them.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile       StudentProfile?
  refreshTokens RefreshToken[]

  @@map("users")
}

/// Refresh tokens are stored as a hash (never the raw token) so a leaked
/// database dump does not itself grant session access. Rotated on every use.
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ---------------------------------------------------------------------------
// Student Profile
// ---------------------------------------------------------------------------

enum WorkModePreference {
  REMOTE
  HYBRID
  ONSITE
  ANY
}

model StudentProfile {
  id     String @id @default(uuid())
  userId String @unique

  fullName           String
  phone              String?
  location           String?
  college            String?
  degree             String?
  branch             String?
  graduationYear     Int?
  cgpa               Float?
  bio                String?
  githubUrl          String?
  linkedinUrl        String?
  portfolioUrl       String?
  preferredRoles     String[]           @default([])
  preferredLocations String[]           @default([])
  workModePreference WorkModePreference @default(ANY)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills         StudentSkill[]
  projects       Project[]
  experience     Experience[]
  certifications Certification[]
  resumes        Resume[]
  matchResults   MatchResult[]

  @@map("student_profiles")
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  CLOUD
  TOOL
  OTHER
}

/// Catalog of known skills, shared across student profiles and (from Phase 3)
/// internship requirements, so matching can compare by skill id rather than
/// fuzzy string matching.
model Skill {
  id       String        @id @default(uuid())
  name     String        @unique
  category SkillCategory @default(OTHER)

  students    StudentSkill[]
  internships InternshipSkill[]

  @@map("skills")
}

model StudentSkill {
  studentProfileId String
  skillId          String
  proficiency      Int? // 1-5 self-rating, optional

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  skill          Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentProfileId, skillId])
  @@index([skillId])
  @@map("student_skills")
}

model Project {
  id               String    @id @default(uuid())
  studentProfileId String
  title            String
  description      String?
  techStack        String[]  @default([])
  url              String?
  startDate        DateTime?
  endDate          DateTime?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("projects")
}

model Experience {
  id               String    @id @default(uuid())
  studentProfileId String
  title            String
  organization     String
  description      String?
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean   @default(false)

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("experience")
}

model Certification {
  id               String    @id @default(uuid())
  studentProfileId String
  name             String
  issuer           String?
  issueDate        DateTime?
  url              String?

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId])
  @@map("certifications")
}

// ---------------------------------------------------------------------------
// Resume (Phase 2)
// ---------------------------------------------------------------------------

enum ResumeStatus {
  UPLOADED
  PARSED
  FAILED
  CONFIRMED
}

/// A single uploaded resume file. Parsing never touches StudentProfile —
/// `parsedData` is only a proposal until the student explicitly confirms
/// it (see resume.service.ts). `storageKey` is opaque to callers; only the
/// configured StorageProvider knows how to resolve it to bytes.
model Resume {
  id               String       @id @default(uuid())
  studentProfileId String
  fileName         String
  mimeType         String
  fileSizeBytes    Int
  storageKey       String
  status           ResumeStatus @default(UPLOADED)
  rawText          String?
  /// ParsedResume (packages/shared/src/types/future.ts), stored as JSON.
  parsedData       Json?
  parserName       String?
  confidence       Float?
  failureReason    String?
  confirmedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)

  @@index([studentProfileId, createdAt])
  @@map("resumes")
}

// ---------------------------------------------------------------------------
// Internship Discovery (Phase 3)
// ---------------------------------------------------------------------------

/// A source of internship listings, e.g. a mock/seed provider in dev or an
/// official partner API in production. Matches InternshipProvider.slug
/// (packages/shared) — rows are upserted by slug when a provider ingests.
model InternshipProvider {
  id          String   @id @default(uuid())
  slug        String   @unique
  displayName String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  internships Internship[]

  @@map("internship_providers")
}

enum InternshipWorkMode {
  REMOTE
  HYBRID
  ONSITE
}

/// A single internship listing, normalized from a provider's raw payload.
/// `externalId` is the provider's own id for the posting; the
/// (providerId, externalId) pair is the duplicate-prevention key used by
/// the ingestion pipeline (internship.ingestion.service.ts).
model Internship {
  id                  String              @id @default(uuid())
  providerId          String
  externalId          String
  title               String
  company             String
  description         String
  responsibilities    String?
  requirements        String?
  location            String?
  workMode            InternshipWorkMode?
  stipendMin          Int?
  stipendMax          Int?
  stipendCurrency     String?             @default("INR")
  durationMonths      Int?
  applicationDeadline DateTime?
  minGraduationYear   Int?
  maxGraduationYear   Int?
  minExperienceMonths Int?
  eligibility         String?
  sourceUrl           String
  applicationUrl      String
  isActive            Boolean             @default(true)

  discoveredAt DateTime @default(now())
  updatedAt    DateTime @updatedAt

  provider     InternshipProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  skills       InternshipSkill[]
  matchResults MatchResult[]

  @@unique([providerId, externalId])
  @@index([isActive, discoveredAt])
  @@index([applicationDeadline])
  @@index([company])
  @@map("internships")
}

model InternshipSkill {
  internshipId String
  skillId      String
  /// true = required, false = preferred/nice-to-have.
  isRequired   Boolean @default(true)

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([internshipId, skillId])
  @@index([skillId])
  @@map("internship_skills")
}

// ---------------------------------------------------------------------------
// Matching Engine (Phase 4)
// ---------------------------------------------------------------------------

/// A deterministic, cached match score between one student and one
/// internship. Recomputed (upserted, never duplicated) whenever
/// matching.service.ts calculates or refreshes a match — see
/// packages/shared MatchingEngine for the scoring contract.
model MatchResult {
  id               String @id @default(uuid())
  studentProfileId String
  internshipId     String
  overallScore     Int
  /// MatchBreakdown (packages/shared/src/types/future.ts), stored as JSON.
  breakdown        Json
  /// MatchExplanation (packages/shared/src/types/future.ts), stored as JSON.
  explanation      Json
  engineName       String

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  studentProfile StudentProfile @relation(fields: [studentProfileId], references: [id], onDelete: Cascade)
  internship     Internship     @relation(fields: [internshipId], references: [id], onDelete: Cascade)

  @@unique([studentProfileId, internshipId])
  @@index([studentProfileId, overallScore])
  @@map("match_results")
}
